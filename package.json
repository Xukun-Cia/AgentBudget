{
  "name": "cursorbudget",
  "displayName": "CursorBudget",
  "description": "本机日账：追踪 Cursor API 用量、工作日剩余与今日消耗。登录态与用量只留在本机。",
  "version": "1.0.2",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "CursorBudget",
      "properties": {
        "cursorBudget.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "状态栏自动刷新间隔（秒）"
        },
        "cursorBudget.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏显示预算信息"
        },
        "cursorBudget.warningThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "API 用量超过此百分比时状态栏显示警告图标"
        },
        "cursorBudget.criticalThresholdPercent": {
          "type": "number",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "description": "API 用量超过此百分比时状态栏显示严重警告图标"
        }
      }
    },
    "commands": [
      {
        "command": "cursorBudget.refresh",
        "title": "CursorBudget: Refresh"
      },
      {
        "command": "cursorBudget.openDashboard",
        "title": "CursorBudget: Open Dashboard"
      },
      {
        "command": "cursorBudget.quickMenu",
        "title": "CursorBudget: Menu"
      }
    ]
  }
}
