{
  "name": "cursorbudget",
  "displayName": "CursorBudget",
  "description": "CursorBudget 可选编辑器配套：只显示 Cursor API、Cursor Models 与 GPT 周额度三项核心指标。",
  "version": "1.2.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "CursorBudget",
      "properties": {
        "cursorBudget.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "状态栏自动刷新间隔（秒）"
        },
        "cursorBudget.showInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏显示预算信息"
        },
        "cursorBudget.warningThresholdPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "API 用量超过此百分比时状态栏显示警告图标"
        },
        "cursorBudget.criticalThresholdPercent": {
          "type": "number",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "description": "API 用量超过此百分比时状态栏显示严重警告图标"
        }
      }
    },
    "commands": [
      {
        "command": "cursorBudget.refresh",
        "title": "CursorBudget: 立即刷新"
      },
      {
        "command": "cursorBudget.openDashboard",
        "title": "CursorBudget: 打开用量页"
      },
      {
        "command": "cursorBudget.quickMenu",
        "title": "CursorBudget: 快捷菜单"
      }
    ]
  }
}
